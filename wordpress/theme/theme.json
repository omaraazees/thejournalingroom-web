{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1160px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "paper",
          "name": "Kertas",
          "color": "#FAF6F0"
        },
        {
          "slug": "paper-deep",
          "name": "Kertas tua",
          "color": "#F1E8DC"
        },
        {
          "slug": "ink",
          "name": "Tinta",
          "color": "#3E2F24"
        },
        {
          "slug": "ink-soft",
          "name": "Tinta lembut",
          "color": "#6B5847"
        },
        {
          "slug": "rose",
          "name": "Rose",
          "color": "#E0B7B4"
        },
        {
          "slug": "rose-deep",
          "name": "Rose tua",
          "color": "#C48B87"
        },
        {
          "slug": "sage",
          "name": "Sage",
          "color": "#93A181"
        },
        {
          "slug": "kraft",
          "name": "Kraft",
          "color": "#B08968"
        },
        {
          "slug": "burgundy",
          "name": "Burgundy",
          "color": "#7C2D2D"
        },
        {
          "slug": "rose-text",
          "name": "Rose teks (aman kontras)",
          "color": "#9F534E"
        },
        {
          "slug": "sage-text",
          "name": "Sage teks (aman kontras)",
          "color": "#616D52"
        },
        {
          "slug": "kraft-text",
          "name": "Kraft teks (aman kontras)",
          "color": "#856245"
        },
        {
          "slug": "kraft-line",
          "name": "Kraft garis komponen",
          "color": "#A87D59"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "writingMode": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Cormorant Garamond",
          "fontFamily": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif"
        },
        {
          "slug": "body",
          "name": "Inter",
          "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
        },
        {
          "slug": "script",
          "name": "Petit Formal Script",
          "fontFamily": "\"Petit Formal Script\", \"Brush Script MT\", cursive"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "Kecil (13)",
          "size": "13px"
        },
        {
          "slug": "base",
          "name": "Teks (16)",
          "size": "16px"
        },
        {
          "slug": "md",
          "name": "Sedang (20)",
          "size": "20px"
        },
        {
          "slug": "lg",
          "name": "Subjudul (28)",
          "size": "28px",
          "fluid": {
            "min": "24px",
            "max": "28px"
          }
        },
        {
          "slug": "xl",
          "name": "Judul kecil (36)",
          "size": "36px",
          "fluid": {
            "min": "30px",
            "max": "36px"
          }
        },
        {
          "slug": "xxl",
          "name": "Judul (48)",
          "size": "48px",
          "fluid": {
            "min": "34px",
            "max": "48px"
          }
        },
        {
          "slug": "xxxl",
          "name": "Judul besar (64)",
          "size": "64px",
          "fluid": {
            "min": "40px",
            "max": "64px"
          }
        },
        {
          "slug": "display",
          "name": "Judul raksasa (80)",
          "size": "80px",
          "fluid": {
            "min": "44px",
            "max": "80px"
          }
        }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "1",
          "name": "8",
          "size": "8px"
        },
        {
          "slug": "2",
          "name": "16",
          "size": "16px"
        },
        {
          "slug": "3",
          "name": "24",
          "size": "24px"
        },
        {
          "slug": "4",
          "name": "32",
          "size": "32px"
        },
        {
          "slug": "5",
          "name": "48",
          "size": "48px"
        },
        {
          "slug": "6",
          "name": "64",
          "size": "64px"
        },
        {
          "slug": "7",
          "name": "96",
          "size": "96px"
        },
        {
          "slug": "8",
          "name": "128",
          "size": "128px"
        }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "card",
          "name": "Kartu",
          "shadow": "0 2px 12px rgba(62,47,36,.06)"
        },
        {
          "slug": "lift",
          "name": "Terangkat",
          "shadow": "0 10px 34px rgba(62,47,36,.10)"
        }
      ]
    },
    "custom": {
      "radius": {
        "card": "16px",
        "photo": "12px",
        "pill": "999px"
      },
      "line": "1px solid rgba(176,137,104,.3)",
      "lineHeight": {
        "tight": "1.12",
        "heading": "1.35",
        "body": "1.7"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--3)",
        "right": "var(--wp--preset--spacing--3)"
      },
      "blockGap": "var(--wp--preset--spacing--3)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "500",
          "lineHeight": "1.12",
          "letterSpacing": "-0.02em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xxxl)",
          "letterSpacing": "-0.035em",
          "lineHeight": "1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)",
          "letterSpacing": "-0.01em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--md)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)",
          "textTransform": "uppercase",
          "letterSpacing": "0.12em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--burgundy)"
          }
        },
        ":focus": {
          "outline": {
            "color": "var(--wp--preset--color--burgundy)",
            "style": "solid",
            "width": "2px",
            "offset": "3px"
          }
        }
      },
      "button": {
        "border": {
          "radius": "999px",
          "width": "1px",
          "style": "solid",
          "color": "transparent"
        },
        "color": {
          "background": "var(--wp--preset--color--burgundy)",
          "text": "var(--wp--preset--color--paper)"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "26px",
            "right": "26px"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "15px",
          "fontWeight": "500"
        },
        ":hover": {
          "color": {
            "background": "color-mix(in srgb, var(--wp--preset--color--burgundy) 82%, var(--wp--preset--color--ink))"
          }
        },
        ":focus": {
          "outline": {
            "color": "var(--wp--preset--color--burgundy)",
            "style": "solid",
            "width": "2px",
            "offset": "3px"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "color": {
          "text": "var(--wp--preset--color--ink-soft)"
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "spacing": {
          "margin": {
            "bottom": "var(--wp--preset--spacing--2)"
          }
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "15px"
        },
        "border": {
          "radius": "16px",
          "width": "1px",
          "style": "solid",
          "color": "var(--wp--preset--color--kraft)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--4)",
            "bottom": "var(--wp--preset--spacing--4)",
            "left": "var(--wp--preset--spacing--4)",
            "right": "var(--wp--preset--spacing--4)"
          }
        }
      },
      "core/details": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--kraft)"
        }
      },
      "core/image": {
        "border": {
          "radius": "12px"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)"
        }
      },
      "core/post-date": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0"
          }
        }
      },
      "core/post-terms": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "halaman-lebar",
      "title": "Halaman lebar",
      "postTypes": [
        "page"
      ]
    }
  ]
}
